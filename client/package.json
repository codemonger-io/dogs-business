{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write src/",
    "postinstall": "cp node_modules/fast_qr/fast_qr_bg.wasm src/lib/fast_qr_wrapper/fast_qr_bg.wasm"
  },
  "dependencies": {
    "@codemonger-io/maplibre-collision-boxes": "0.1.0-48c016f",
    "@codemonger-io/maplibre-geo-circle-layer": "0.1.0-e0d4986",
    "@codemonger-io/passquito-client-js": "0.0.3-2f4476f",
    "@vueuse/core": "^13.9.0",
    "buefy": "^3.0.3",
    "bulma": "^1.0.4",
    "fast_qr": "^0.13.0",
    "lucide-static": "^0.563.0",
    "maplibre-gl": "^5.16.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.15.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "cypress": "^13.17.0",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.8.0",
    "sass": "^1.97.2",
    "start-server-and-test": "^2.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unplugin-vue-markdown": "^28.3.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
